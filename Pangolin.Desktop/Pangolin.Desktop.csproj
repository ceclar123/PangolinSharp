<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Pangolin.Desktop</AssemblyName>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <StartupObject>Pangolin.Desktop.Program</StartupObject>
        <PublishAot>false</PublishAot>
        <PackageIcon>pangolin_32.ico</PackageIcon>
        <ApplicationIcon>Assets\icon\pangolin_32.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="MacOSPublish\tray.icns" />
        <AvaloniaResource Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\json\menu.json" />
        <None Remove="Assets\pangolin_128.ico" />
        <None Remove="Assets\pangolin_16.ico" />
        <None Remove="Assets\pangolin_256.ico" />
        <None Remove="Assets\pangolin_32.ico" />
        <None Remove="Assets\pangolin_48.ico" />
        <None Remove="Assets\pangolin_64.ico" />
        <None Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\icon\pangolin_32.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <!--    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" /> -->
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <!--Condition below is needed to remove AvaloniaUI.DiagnosticsSupport package from build output in Release configuration.-->        
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.1.4" />
        <PackageReference Include="NLog" Version="6.2.1" />
        <PackageReference Include="ReactiveUI.Validation" Version="8.1.0" />
        <PackageReference Include="CsvHelper" Version="33.1.0" />        
        <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
        <PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.1.0.1" />
        <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pangolin.Utility\Pangolin.Utility.csproj" />
        <ProjectReference Include="..\Pangolin.SQLite\Pangolin.SQLite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Update="Assets\icon\pangolin_32.ico">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </AvaloniaResource>
        <AvaloniaResource Update="Assets\json\menu.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </AvaloniaResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\icon\pangolin_32.ico">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Views\Postman\**\*.axaml" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Remove="Config\**" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaXaml Include="Views\Postman\PostmanUserControl.axaml">
        <SubType>Designer</SubType>
      </AvaloniaXaml>
    </ItemGroup>
</Project>
